{
  "name": "cinesync-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CineSync backend service (Express + Socket.IO + TypeScript). Foundation only.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:watch-party": "tsx test/watch-party.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "nanoid": "^5.1.16",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.14.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
